// 列出所有的Software

func ListSoftware(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		var softWares []model.Software
		result := db.Order("id DESC").Find(&softWares) //让 GORM 查询 software 表，并按照 ID 从大到小排序
		//再把查询结果填入 softWares。 返回的是*gorm.DB本身 因为这里是链式调用

		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    5001,
				"message": "查询软件列表失败",
				"data":    nil,
			})
			return
		}
		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "查询链表成功",
			"data":    softWares,
		})
	}
}

// create 接受数据

func CreateSoftware(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		var req []request.SoftwareReq
		//如果前端多传了字段（比如传了 "price": 100），但结构体里没有，Gin 默认会直接忽略它。
		//把客户端发送的 JSON 解析到 req 中，并根据 binding 标签进行校验。
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "请求参数不合法" + err.Error(),
				"data":    nil,
			})
			return
		}
		var software []model.Software
		for _, item := range req {
			software = append(software, model.Software{
				Name:        item.Name,
				Description: item.Description,
				Version:     item.Version,
			})
		}
		//让 GORM 将软件记录插入数据库。成功后，数据库生成的 ID 等字段会回填到 software 对象中。
		if err := db.Create(&software).Error; err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50001,
				"message": err.Error(),
				"data":    nil,
			})
			return
		}
		//返回成功的结果
		c.JSON(http.StatusCreated, gin.H{
			"code":    0,
			"message": "success",
			"data":    software,
		})
	}
}

// update 单个

func UpdateSoftware(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		id, err := strconv.ParseUint(c.Param("id"), 10, 64)
		if err != nil || id == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件id不合法",
				"data":    nil,
			})
			return
		}
		req := request.SoftwareReq{}
		var software model.Software

		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "请求参数不合法" + err.Error(),
				"data":    nil,
			})
			return
		}

		result := db.First(&software, id)

		if errors.Is(result.Error, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": "软件不存在",
				"data":    nil,
			})
			return
		}
		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50001,
				"message": "查询软件失败",
				"data":    nil,
			})
			return
		}
		result = db.Model(&software).Updates(map[string]any{
			"name":        req.Name,
			"description": req.Description,
			"version":     req.Version,
		}) // GORM 使用结构体更新时，默认会忽略零值字段。
		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50002,
				"message": "软件更新失败",
				"data":    nil,
			})
			return
		}

		if err := db.First(&software, id).Error; err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50003,
				"message": "获取软件更新失败",
				"data":    nil,
			})
			return
		}
		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "success",
			"data":    software,
		})

	}
}

// 获取id

func GetSoftwareByID(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		//url里获取
		idStr := c.Param("id")
		//将字符串ID转换为整数
		//将字符串安全的转换为go语言里的整数 base是进制 bitSize是多少位
		id, err := strconv.ParseUint(idStr, 10, 64)
		if err != nil || id == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件id不合法",
				"data":    nil,
			})
			return
		}
		var software model.Software
		//去数据库里查一条主键（ID）等于 id 的那条记录。，把查到的数据填到 software 变量里
		result := db.First(&software, id)
		//SELECT * FROM software ORDER BY id LIMIT 1;
		//当 First 的第二个参数是一个纯数字（或字符串形式的数字）时，GORM 默认把它当作“主键（Primary Key）”的查询值。
		//First 是 GORM 中专门用来“查询单条记录”的核心函数。
		//如果用一句话总结：它会去数据库里找符合条件的第一条数据，并且按主键从小到大排序。

		if errors.Is(result.Error, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": "软件不存在",
				"data":    nil,
			})
			return
		}

		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50001,
				"message": "查询软件详情失败",
				"data":    nil,
			})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "success",
			"data":    software,
		})
		db.Model(&software).Update("version", software.Version)

	}
}

// delete单个软件

func DeleteSoftware(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		softwareID, err := strconv.ParseUint(c.Param("id"), 10, 64)
		if err != nil || softwareID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件ID不合法",
				"data":    nil,
			})
			return
		}
		var software model.Software

		err = db.Transaction(func(tx *gorm.DB) error {
			if err := tx.First(&software, softwareID).Error; err != nil {
				return err
			}
			if err := tx.Where("software_id = ?", softwareID).Delete(&model.SoftwareVersion{}).Error; err != nil {
				return err
			}
			if err := tx.Delete(&software).Error; err != nil {
				return err
			}
			return nil
		})

		if errors.Is(err, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": "软件不存在",
				"data":    nil,
			})
			return
		}

		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50002,
				"message": "删除软件失败",
				"data":    nil,
			})
			return
		}
		uploadDir := filepath.Join("uploads", "software", strconv.FormatUint(softwareID, 10))
		_ = os.RemoveAll(uploadDir)
		//另外，GORM 的 Delete() 还有一个重要知识点：
		//- 如果模型没有定义软删除字段，通常执行真正的 SQL 删除。
		//- 如果模型包含 gorm.DeletedAt，GORM 默认会进行软删除，即标记删除时间，而不是立即删除记录。
		//我们目前的 Software 模型没有 gorm.DeletedAt，因此这里执行的是物理删除。
		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "success",
			"data":    software,
		})

	}
}

func CreateSoftwareVersion(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		softwareID, err := strconv.ParseUint(c.Param("id"), 10, 64)
		if err != nil || softwareID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件ID不合法",
				"data":    nil,
			})
			return
		}

		req := request.VersionReq{}

		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "版本号和下载地址不能为空",
				"data":    nil,
			})
			return
		}

		var softwareVersion model.SoftwareVersion

		//这里从查询开始上锁 保证只有一个人对数据修改
		err = db.Transaction(func(tx *gorm.DB) error {
			var software model.Software
			//为接下来的查询语句加上行级排他锁（在 SQL 末尾拼上 FOR UPDATE）。
			if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).First(&software, softwareID).Error; err != nil {
				return err
			}

			var maxVersionID uint

			if err := tx.Model(&softwareVersion).Where("software_id = ?", softwareID).Select("coalesce(max(version_id), 0)").Scan(&maxVersionID).Error; err != nil {
				return err
			}

			softwareVersion = model.SoftwareVersion{
				SoftwareID:  software.ID,
				VersionID:   maxVersionID + 1,
				Version:     req.Version,
				Description: req.Description,
				DownloadURL: req.DownloadURL,
			}
			return tx.Create(&softwareVersion).Error //create新的记录
		})
		if errors.Is(err, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": "软件不存在",
				"data":    nil,
			})
			return
		}

		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50003,
				"message": "软件创建失败",
				"data":    nil,
			})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "success",
			"data":    softwareVersion,
		})
	}
}

func GetSoftwareVersion(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		softwareID, err := strconv.ParseUint(c.Param("id"), 10, 64)
		if err != nil || softwareID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件ID不合法",
				"data":    nil,
			})
			return
		}
		var software model.Software
		result := db.First(&software, softwareID)
		if errors.Is(result.Error, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": "软件不存在",
				"data":    nil,
			})
			return
		}
		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50001,
				"message": "查询软件失败",
				"data":    nil,
			})
			return
		}
		//查询所有版本

		var softwareVersions []model.SoftwareVersion
		result = db.Where("software_id = ?", software.ID).Order("created_at DESC").Find(&softwareVersions)
		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50002,
				"message": "查询软件失败",
				"data":    nil,
			})
			return
		}
		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "success",
			"data":    softwareVersions,
		})

	}
}

