func UploadSoftwareFile(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {

		softwareID, err := strconv.ParseUint(c.Param("id"), 10, 64)
		if err != nil || softwareID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件ID不合法",
				"data":    nil,
			})
			return
		}
		versionID, err := strconv.ParseUint(c.Param("versionID"), 10, 64)
		if err != nil || versionID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40002,
				"message": "版本ID不合法",
				"data":    nil,
			})
			return
		}

		var version model.SoftwareVersion
		result := db.Where("software_id = ? AND version_id = ?", softwareID, versionID).First(&version)
		if errors.Is(result.Error, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": " 软件版本不存在",
				"data":    nil,
			})
			return
		}

		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50001,
				"message": "查询软件版本失败",
				"data":    nil,
			})
			return
		}

		// 从 multipart/form-data 请求中获取名为 "file" 的上传文件
		file, err := c.FormFile("file")
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50002,
				"message": "请上传文件(文件名要为file)",
				"data":    nil,
			})
			return
		}

		const maxFileSize = 500 << 20
		if file.Size > maxFileSize {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    40004,
				"message": "上传文件大小不能大于500mb",
				"data":    nil,
			})
			return
		}

		uploadDir := filepath.Join("uploads", "software", strconv.FormatUint(softwareID, 10))

		if err := os.MkdirAll(uploadDir, 0755); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50002,
				"message": "创建上传目录失败",
				"data":    nil,
			})
			return
		}

		ext := filepath.Ext(file.Filename) //自动提取后缀
		filename := fmt.Sprintf("version-%d%s", versionID, ext)
		savePath := filepath.Join(uploadDir, filename)
		if err := c.SaveUploadedFile(file, savePath); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50003,
				"message": "保存文件失败",
				"data":    nil,
			})
			return
		}

		downloadPath := fmt.Sprintf("/api/v1/software/%d/versions/%d/download", softwareID, versionID)
		if err := db.Model(&version).Update("download_url", downloadPath).Error; err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50004,
				"message": "更新软件地址失败",
				"data":    nil,
			})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"code":    0,
			"message": "success",
			"data":    version,
		})

	}
}

func DownloadSoftwareFile(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
		softwareID, err := strconv.ParseUint(c.Param("id"), 10, 64)
		if err != nil || softwareID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40001,
				"message": "软件ID不合法",
				"data":    nil,
			})
			return
		}
		versionID, err := strconv.ParseUint(c.Param("version"), 10, 64)
		if err != nil || versionID == 0 {
			c.JSON(http.StatusBadRequest, gin.H{
				"code":    40002,
				"message": "版本ID不合法",
				"data":    nil,
			})
			return
		}
		var version model.SoftwareVersion
		result := db.Where("software_id = ? AND version_id = ?", softwareID, versionID).First(&version)
		if errors.Is(result.Error, gorm.ErrRecordNotFound) {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40401,
				"message": "软件版本不存在",
				"data":    nil,
			})
			return
		}
		if result.Error != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"code":    50002,
				"message": "查询软件失败",
				"data":    nil,
			})
			return
		}

		pattern := filepath.Join("uploads", "software", strconv.FormatUint(softwareID, 10), fmt.Sprintf("version-%d.*", versionID))
		//他会在xx/xx/xx/2/里找前缀符合version.的 并返回[]string
		matches, err := filepath.Glob(pattern)
		if err != nil || len(matches) == 0 {
			c.JSON(http.StatusNotFound, gin.H{
				"code":    40402,
				"message": "该版本尚未上传安装包文件",
				"data":    nil,
			})
			return
		}
		filePath := matches[0]
		downloadName := filepath.Base(filePath) // 获取路径中最后一个斜杠后面的文件名
		// 它会读取磁盘上的 filePath 文件流，并自动在 HTTP 响应头里加上 Content-Disposition: attachment; filename="version-3.zip"。浏览器看到这个响应头，就不会直接把内容当网页显示出来，而是直接弹出“保存文件”下载框！
		c.FileAttachment(filePath, downloadName) // http响应头里的filename就是downloadName
	}
}
